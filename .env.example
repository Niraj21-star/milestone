# ============================================================
# Milepost — Environment Variable Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ─── Django ─────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Set to False in production
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts (production)
# Example: DJANGO_ALLOWED_HOSTS=milepost-api.onrender.com,localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to make cross-origin requests (production)
# Example: CORS_ALLOWED_ORIGINS=https://milepost.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Frontend (Vite) ────────────────────────────────────────
# Base URL of the Django API — used by the React app at build time
VITE_API_BASE_URL=http://localhost:8000

# ─── Optional: External Services ────────────────────────────
# No API keys are required:
#   Routing:     OSRM public demo server (no key needed)
#   Geocoding:   Nominatim / OpenStreetMap (no key needed)
#   Map tiles:   OpenStreetMap via Leaflet (no key needed)
