# ============================================================
# Milepost — Environment Variable Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ─── Django ─────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Set to False in production
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts (production)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to make cross-origin requests (production)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Geocoding API ──────────────────────────────────────────
# Google Geocoding API key for forward and reverse geocoding
GOOGLE_MAPS_API_KEY=

# ─── Frontend (Vite) ────────────────────────────────────────
# Base URL of the Django API — used by the React app at build time
VITE_API_BASE_URL=http://localhost:8000
