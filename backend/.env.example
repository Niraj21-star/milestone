# Django Security & Server Settings
DJANGO_SECRET_KEY=change-this-to-a-secure-secret-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,milepost-api.example.com

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://milepost.example.com

# Nominatim / External Services Configuration
NOMINATIM_USER_AGENT=milepost-trip-planner/1.0
NOMINATIM_THROTTLE_SECONDS=1.1
EXTERNAL_TIMEOUT_SECONDS=5
EXTERNAL_MAX_RETRIES=1
