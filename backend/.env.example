# Django Security & Server Settings
DJANGO_SECRET_KEY=change-this-to-a-secure-secret-key-in-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,milepost-backend.onrender.com

# CORS Configuration (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://milepost.vercel.app

# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=

# External Services Timeouts & Retries
EXTERNAL_TIMEOUT_SECONDS=5
EXTERNAL_MAX_RETRIES=1
